# ==========================================
# PayCertus / Payroll Sentinel Configuration
# ==========================================

# MongoDB Database Connection (Local MongoDB or MongoDB Atlas Cloud)
# Format Local: mongodb://localhost:27017
# Format Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=payroll_sentinel

# Security & Tokens
SECRET_KEY=payroll_sentinel_enterprise_secret_key_2026

# Optional: LLM Provider API Keys (OpenAI / Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
