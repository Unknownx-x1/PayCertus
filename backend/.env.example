# User-Defined MongoDB Connection String:
# Replace the value below with YOUR OWN MongoDB connection string.
#
# Option A (MongoDB Atlas Cloud):
# MONGODB_URL=mongodb+srv://<your_user>:<your_password>@<your_cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Option B (Local MongoDB):
# MONGODB_URL=mongodb://localhost:27017

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=payroll_sentinel

# Security Settings
SECRET_KEY=payroll_sentinel_enterprise_secret_key_2026

# Optional LLM API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
